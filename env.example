# Optional - leave MT5_* blank to attach to whichever account the open MT5 terminal is logged into.
TV_USERNAME=
TV_PASSWORD=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Safety switches (both default to the safe setting if missing)
# DRY_RUN=true  -> orders are only logged. Set to false to send orders (to a demo account).
DRY_RUN=true
# ALLOW_LIVE=false -> refuses to trade a real-money account. Set to true only when you mean to.
ALLOW_LIVE=false

# LLM trade reviewer (optional). Without a key the bot still trades and journals; reviews are skipped.
# Create a key in the Anthropic Console (API keys). Reviews send each closed trade's details to Anthropic.
ANTHROPIC_API_KEY=
# REVIEW_MODEL=claude-sonnet-5-5    # default; claude-haiku-5-5 is a cheaper option
# JOURNAL_DIR=journal               # where trade records and journal.md are written
